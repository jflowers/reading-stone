{
  "name": "reading-stone",
  "version": "0.2.0",
  "description": "TypeScript side-effect analyzer backend for Gaze",
  "keywords": [
    "gaze",
    "typescript",
    "javascript",
    "static-analysis",
    "side-effects",
    "json-rpc",
    "analyzer",
    "test-quality"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "author": "zero-dot-force",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zero-dot-force/reading-stone.git"
  },
  "homepage": "https://github.com/zero-dot-force/reading-stone#readme",
  "bugs": {
    "url": "https://github.com/zero-dot-force/reading-stone/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reading-stone": "dist/main.js",
    "gaze-analyzer-typescript": "dist/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "vitest": "^5.0.5"
  }
}
