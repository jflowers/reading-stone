# Dependencies
node_modules/

# Build output
dist/

# Test / coverage reports
coverage/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# Editors
.idea/
.vscode/

# opencode run logs written under an unresolved path (.opencode/undefined/)
.opencode/undefined/

# Unbound Force — managed by uf init
# Runtime data under .uf/ (databases, caches, locks, logs)
.uf/workflows/
.uf/artifacts/
.uf/dewey/graph.db
.uf/dewey/graph.db-shm
.uf/dewey/graph.db-wal
.uf/dewey/*.lock
.uf/dewey/cache/
.uf/dewey/learnings/
.uf/dewey/dewey.log
.uf/replicator/*.db
.uf/replicator/*.db-shm
.uf/replicator/*.db-wal
.uf/replicator/*.lock
.uf/muti-mind/artifacts/
.uf/mx-f/data/
# Workspace state under .uf/ (sibling clones and caches, feedback, progress)
.uf/sibling-clones/
.uf/sibling-cache/
.uf/feedback/
.uf/progress/
# Per-developer configuration and override files — never commit provider-specific model strings
.uf/config.yaml
.uf/dewey/config.yaml
.uf/review-matrix.override.yaml
.uf/model-matrix.override.yaml
# Devcontainer — OS-specific, generated by uf sandbox init
.devcontainer/

# opencode local config — machine-specific permissions
.opencode/opencode.json
